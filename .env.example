# =============================================================================
# EarningsPulse — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- App URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Backend ---
ENVIRONMENT=development
DEBUG=false

# --- LLM (required for agent phases) ---
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here   # Optional fallback
LLM_MODEL=gpt-4o

# --- Hackathon Partners ---
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Market Data ---
FINNHUB_API_KEY=your-finnhub-key-here

# --- SEC EDGAR (required User-Agent per SEC fair access policy) ---
SEC_USER_AGENT=EarningsPulse your-email@example.com

# --- PRISM (Block Convey) — add at hackathon if available ---
# PRISM_API_KEY=pt-sk-your-key-here
# PRISM_PROJECT_ID=your-project-id
# PRISM_HOST=https://api.prism.blockconvey.com

# --- Optional ---
# REDIS_URL=redis://localhost:6379
